<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:launcher="http://schemas.android.com/apk/res-auto"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.launcher3">

    <SwitchPreferenceCompat
        android:key="pref_allapps_themed_icons"
        android:title="@string/pref_themed_icons_title"
        android:summary="@string/pref_themed_icons_summary"
        android:defaultValue="false"
        android:persistent="true" />

    <SwitchPreferenceCompat
        android:key="pref_app_library_enabled"
        android:title="@string/pref_app_library_title"
        android:summary="@string/pref_app_library_summary"
        android:defaultValue="false"
        android:persistent="true" />

    <SwitchPreferenceCompat
        android:key="pref_app_library_single_page"
        android:title="@string/pref_app_library_single_page_title"
        android:summary="@string/pref_app_library_single_page_summary"
        android:defaultValue="false"
        android:persistent="true"
        android:dependency="pref_app_library_enabled" />

    <SwitchPreferenceCompat
        android:key="pref_drawer_show_labels"
        android:title="@string/drawer_show_labels"
        android:defaultValue="true"
        android:persistent="true" />

    <SwitchPreferenceCompat
        android:key="pref_focus_mode"
        android:title="@string/pref_focus_mode_title"
        android:summary="@string/pref_focus_mode_summary"
        android:defaultValue="true"
        android:persistent="true" />

    <PreferenceCategory
        android:title="@string/search_bar_category_title"
        launcher:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            android:key="pref_drawer_search"
            android:title="@string/drawer_search_title"
            android:summary="@string/drawer_search_summary"
            android:defaultValue="true"
            launcher:iconSpaceReserved="false" />

        <ListPreference
            android:key="pref_all_apps_search_bar_placement"
            android:title="@string/search_bar_placement_title"
            android:summary="%s"
            android:entries="@array/search_bar_placement_entries"
            android:entryValues="@array/search_bar_placement_values"
            android:defaultValue="top"
            android:persistent="true"
            android:dependency="pref_drawer_search"
            launcher:iconSpaceReserved="false" />

        <ListPreference
            android:key="pref_all_apps_search_bar_appearance"
            android:title="@string/search_bar_appearance_title"
            android:summary="%s"
            android:entries="@array/search_bar_appearance_entries"
            android:entryValues="@array/search_bar_appearance_values"
            android:defaultValue="default"
            android:persistent="true"
            android:dependency="pref_drawer_search"
            launcher:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/scroll_category_title"
        launcher:iconSpaceReserved="false">

    <SwitchPreferenceCompat
        android:key="pref_drawer_scrollbar"
        android:title="@string/drawer_scrollbar_title"
        android:summary="@string/drawer_scrollbar_summary"
        android:defaultValue="true"
        launcher:iconSpaceReserved="false" />

    <SwitchPreferenceCompat
        android:key="pref_enable_two_line_toggle"
        android:title="@string/icon_two_lines_title"
        android:defaultValue="false"
        android:persistent="true"
        launcher:iconSpaceReserved="false" />

    <com.android.launcher3.settings.preferences.CustomSeekBarPreference
        android:key="pref_row_height"
        android:title="@string/row_height_title"
        android:persistent="true"
        android:max="150"
        settings:min="75"
        settings:units="%"
        android:defaultValue="100" />

    </PreferenceCategory>

</androidx.preference.PreferenceScreen>
