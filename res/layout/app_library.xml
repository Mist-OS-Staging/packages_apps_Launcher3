<?xml version="1.0" encoding="utf-8"?>
<com.android.launcher3.applibrary.view.AppLibraryContainerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/app_library_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:visibility="invisible">

    <LinearLayout
        android:id="@+id/app_library_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.android.launcher3.applibrary.view.AppLibrarySearchBar
            android:id="@+id/app_library_search_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:id="@+id/app_library_search_box"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/app_library_search_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:id="@+id/app_library_search_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_app_library_search"
                    android:contentDescription="@null" />

                <EditText
                    android:id="@+id/app_library_search_input"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:gravity="center"
                    android:background="@null"
                    android:hint="@string/app_library_search_hint"
                    android:imeOptions="actionSearch|flagNoExtractUi"
                    android:inputType="text|textNoSuggestions|textCapWords"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textColorHint="?android:attr/textColorSecondary"
                    android:textSize="16sp" />

                <ImageButton
                    android:id="@+id/app_library_search_clear"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_app_library_clear"
                    android:contentDescription="@string/app_library_search_clear"
                    android:visibility="gone" />

            </LinearLayout>

            <TextView
                android:id="@+id/app_library_search_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/app_library_search_cancel"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:visibility="gone" />

        </com.android.launcher3.applibrary.view.AppLibrarySearchBar>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/app_library_grid_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="24dp"
                android:clipToPadding="false"
                android:overScrollMode="ifContentScrolls" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/app_library_search_results_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="8dp"
                android:paddingEnd="24dp"
                android:paddingBottom="24dp"
                android:clipToPadding="false"
                android:background="@drawable/app_library_search_list_bg"
                android:overScrollMode="ifContentScrolls"
                android:visibility="gone" />

            <com.android.launcher3.applibrary.view.AppLibraryAlphabetIndexer
                android:id="@+id/app_library_alphabet_indexer"
                android:layout_width="20dp"
                android:layout_height="match_parent"
                android:layout_gravity="end|center_vertical"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:layout_marginEnd="4dp"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

    <include layout="@layout/app_library_expanded_sheet" />

</com.android.launcher3.applibrary.view.AppLibraryContainerView>
