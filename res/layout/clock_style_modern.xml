<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:launcher="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Weather Top Right -->
    <LinearLayout
        android:id="@+id/quick_event_weather_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <ImageView
            android:id="@+id/quick_event_weather_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="6dp" />
            
        <TextView
            android:id="@+id/quick_event_weather_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?workspaceTextColor"
            android:textSize="16sp"
            android:alpha="0.9" />
    </LinearLayout>

    <!-- Clock -->
    <TextClock
        android:id="@+id/clock_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:textColor="?workspaceTextColor"
        android:textSize="72sp"
        android:format12Hour="h:mm"
        android:format24Hour="H:mm"
        android:includeFontPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <!-- Day & Date (Below Clock) -->
    <LinearLayout
        android:id="@+id/day_date_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/clock_time"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/quickspace_day_of_week"
            android:fontFamily="sans-serif-condensed-medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?workspaceTextColor"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" • "
            android:textColor="?workspaceTextColor"
            android:textSize="18sp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp" />

        <TextView
            android:id="@+id/clock_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?workspaceTextColor"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- Contextual Info (Now Playing or PSA) -->
    <FrameLayout
        android:id="@+id/contextual_info_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/day_date_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Now Playing -->
        <LinearLayout
            android:id="@+id/now_playing_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">
            
            <ImageView
                android:id="@+id/now_playing_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_music_note"
                android:tint="?workspaceTextColor"
                android:layout_marginEnd="6dp"/>
                
            <TextView
                android:id="@+id/now_playing_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?workspaceTextColor"
                android:textSize="16sp"
                android:maxLines="1"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:scrollHorizontally="true"/>
        </LinearLayout>

        <!-- PSA Message -->
        <TextView
            android:id="@+id/quickspace_psa_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?workspaceTextColor"
            android:textSize="16sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:gravity="center"
            android:visibility="gone" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
