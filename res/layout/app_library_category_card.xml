<?xml version="1.0" encoding="utf-8"?>
<com.android.launcher3.applibrary.view.AppCategoryCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:launcher="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="6dp">

    <TextView
        android:id="@+id/category_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="6dp"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary"
        android:singleLine="true"
        android:ellipsize="end" />

    <LinearLayout
        android:id="@+id/category_card_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/app_library_card_bg"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.android.launcher3.BubbleTextView
                android:id="@+id/card_slot_0"
                style="@style/BaseIcon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:textSize="11sp"
                launcher:iconDisplay="all_apps"
                android:visibility="invisible" />

            <com.android.launcher3.BubbleTextView
                android:id="@+id/card_slot_1"
                style="@style/BaseIcon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:textSize="11sp"
                launcher:iconDisplay="all_apps"
                android:visibility="invisible" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <com.android.launcher3.BubbleTextView
                android:id="@+id/card_slot_2"
                style="@style/BaseIcon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:textSize="11sp"
                launcher:iconDisplay="all_apps"
                android:visibility="invisible" />

            <FrameLayout
                android:id="@+id/card_slot_3_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <com.android.launcher3.BubbleTextView
                    android:id="@+id/card_slot_3_single"
                    style="@style/BaseIcon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:textSize="11sp"
                    launcher:iconDisplay="all_apps"
                    android:visibility="invisible" />

                <LinearLayout
                    android:id="@+id/card_slot_3_mini_cluster"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:background="@drawable/app_library_mini_cluster_bg"
                    android:padding="6dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/mini_icon_0"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_margin="2dp"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter" />

                        <ImageView
                            android:id="@+id/mini_icon_1"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_margin="2dp"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/mini_icon_2"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_margin="2dp"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter" />

                        <ImageView
                            android:id="@+id/mini_icon_3"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_margin="2dp"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter" />

                    </LinearLayout>

                </LinearLayout>

            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

</com.android.launcher3.applibrary.view.AppCategoryCardView>
