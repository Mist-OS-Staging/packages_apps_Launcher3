<?xml version="1.0" encoding="utf-8"?>
<!-- CLOCK 5 — Flip Block | Style value: 5 -->
<!-- Font: res/font/ios.ttf -->
<!-- Drawable: res/drawable/flip_block_bg.xml -->

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:launcher="http://schemas.android.com/apk/res-auto"
    android:id="@+id/quickspace_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="start|center_vertical"
    android:orientation="vertical"
    android:background="#FF1C1C1C"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Day of the Week -->
    <com.android.launcher3.quickspace.views.DoubleShadowTextView
        android:id="@+id/quickspace_day_of_week"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFF0C040"
        android:textSize="12sp"
        android:fontFamily="@font/ios"
        android:letterSpacing="0.15"
        launcher:ambientShadowBlur="3dp"
        launcher:ambientShadowColor="?workspaceAmbientShadowColor"
        launcher:keyShadowBlur="2dp"
        launcher:keyShadowColor="?workspaceKeyShadowColor"
        launcher:keyShadowOffsetX="0.5dip" />

    <!-- Clock — HH : MM : SS in flip block row -->
    <!-- Uses a HorizontalScrollView wrapper to prevent clipping on small screens -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginTop="4dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Hour block -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/flip_block_bg"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">
                <TextClock
                    android:id="@+id/quickspace_clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ios"
                    android:textColor="#FFF0C040"
                    android:textSize="52sp"
                    android:format12Hour="hh"
                    android:format24Hour="HH"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- Colon separator -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=":"
                android:textColor="#FF555555"
                android:textSize="36sp"
                android:fontFamily="@font/ios"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="6dp" />

            <!-- Minute block -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/flip_block_bg"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">
                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ios"
                    android:textColor="#FFF0C040"
                    android:textSize="52sp"
                    android:format12Hour="mm"
                    android:format24Hour="mm"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- Colon separator -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=":"
                android:textColor="#FF555555"
                android:textSize="36sp"
                android:fontFamily="@font/ios"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="6dp" />

            <!-- Second block -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/flip_block_bg"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">
                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ios"
                    android:textColor="#FFF0C040"
                    android:textSize="52sp"
                    android:format12Hour="ss"
                    android:format24Hour="ss"
                    android:includeFontPadding="false" />
            </LinearLayout>

        </LinearLayout>

    </HorizontalScrollView>

    <!-- Date + Weather row -->
    <LinearLayout
        android:id="@+id/date_weather_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <com.android.launcher3.quickspace.views.DoubleShadowTextView
            android:id="@+id/quickspace_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF888888"
            android:textSize="12sp"
            android:fontFamily="@font/ios"
            android:paddingEnd="10dp"
            launcher:ambientShadowBlur="3dp"
            launcher:ambientShadowColor="?workspaceAmbientShadowColor"
            launcher:keyShadowBlur="2dp"
            launcher:keyShadowColor="?workspaceKeyShadowColor"
            launcher:keyShadowOffsetX="0.5dip" />

        <include layout="@layout/quickspace_weather_content" />

    </LinearLayout>

    <!-- Contextual Info: Now Playing / PSA -->
    <FrameLayout
        android:id="@+id/contextual_info_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">

        <!-- Now Playing -->
        <LinearLayout
            android:id="@+id/now_playing_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">
            <ImageView
                android:id="@+id/now_playing_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_music_note_24dp"
                android:tint="#FFF0C040"
                android:layout_marginEnd="6dp" />
            <TextView
                android:id="@+id/now_playing_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFF0C040"
                android:textSize="12sp"
                android:fontFamily="@font/ios"
                android:singleLine="true" />
        </LinearLayout>

        <!-- PSA Message -->
        <com.android.launcher3.quickspace.views.DoubleShadowTextView
            android:id="@+id/quickspace_psa_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF888888"
            android:textSize="12sp"
            android:fontFamily="@font/ios"
            android:visibility="gone"
            launcher:ambientShadowBlur="3dp"
            launcher:ambientShadowColor="?workspaceAmbientShadowColor"
            launcher:keyShadowBlur="2dp"
            launcher:keyShadowColor="?workspaceKeyShadowColor"
            launcher:keyShadowOffsetX="0.5dip" />

    </FrameLayout>

</LinearLayout>
