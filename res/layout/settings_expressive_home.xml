<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_expressive_background">

    <ScrollView
        android:id="@+id/settings_home_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:id="@+id/settings_home_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <TextView
                android:id="@+id/settings_home_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.01"
                android:lineSpacingMultiplier="0.95"
                android:paddingStart="24dp"
                android:paddingTop="72dp"
                android:paddingEnd="24dp"
                android:paddingBottom="18dp"
                android:text="@string/settings_title"
                android:textColor="@color/settings_expressive_on_surface"
                android:textSize="40sp" />

            <LinearLayout
                android:id="@+id/settings_home_search"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginHorizontal="16dp"
                android:background="@drawable/settings_expressive_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_settings_expressive_search"
                    android:tint="@color/settings_expressive_on_surface_variant" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="@string/settings_search_hint"
                    android:textColor="@color/settings_expressive_on_surface_variant"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <include
                    android:id="@+id/settings_tile_icons"
                    layout="@layout/settings_expressive_tile"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/settings_tile_home"
                        layout="@layout/settings_expressive_tile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <include
                        android:id="@+id/settings_tile_app_drawer"
                        layout="@layout/settings_expressive_tile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <include
                    android:id="@+id/settings_tile_recents"
                    layout="@layout/settings_expressive_tile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/settings_tile_misc"
                    layout="@layout/settings_expressive_tile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/settings_home_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:alpha="0"
        android:background="@color/settings_expressive_surface_high">

        <TextView
            android:id="@+id/settings_home_bar_title"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="24dp"
            android:gravity="center_vertical"
            android:text="@string/settings_title"
            android:textColor="@color/settings_expressive_on_surface"
            android:textSize="20sp" />
    </FrameLayout>
</FrameLayout>
