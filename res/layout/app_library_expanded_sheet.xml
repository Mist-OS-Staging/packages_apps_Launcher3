<?xml version="1.0" encoding="utf-8"?>
<com.android.launcher3.applibrary.view.AppCategoryExpandedSheet
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/app_library_expanded_sheet"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000"
    android:clickable="true"
    android:focusable="true"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/expanded_sheet_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/app_library_card_bg"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:elevation="12dp">

        <RelativeLayout
            android:id="@+id/expanded_sheet_header"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp">

            <ImageButton
                android:id="@+id/expanded_sheet_back_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_app_library_back"
                android:contentDescription="@string/app_library_search_cancel" />

            <TextView
                android:id="@+id/expanded_sheet_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:singleLine="true"
                android:ellipsize="end" />

        </RelativeLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/expanded_sheet_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="ifContentScrolls" />

    </LinearLayout>

</com.android.launcher3.applibrary.view.AppCategoryExpandedSheet>
